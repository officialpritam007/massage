rules_version = '2';
// Release sync: redeploy the verified 1-to-1 messaging rules with send recovery.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeAccount() {
      return signedIn() && !exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid));
    }

    function owner(uid) {
      return activeAccount() && request.auth.uid == uid;
    }

    function conversationExists(cid) {
      return exists(/databases/$(database)/documents/conversations/$(cid));
    }

    function membersActive(data) {
      return data.participantIds is list && data.participantIds.size() == 2
        && !exists(/databases/$(database)/documents/accountDeletionRequests/$(data.participantIds[0]))
        && !exists(/databases/$(database)/documents/accountDeletionRequests/$(data.participantIds[1]));
    }

    function otherParticipant(data) {
      return data.participantIds[0] == request.auth.uid
        ? data.participantIds[1]
        : data.participantIds[0];
    }

    function participant(cid) {
      return activeAccount()
        && conversationExists(cid)
        && get(/databases/$(database)/documents/conversations/$(cid)).data.get('purging', false) == false
        && membersActive(get(/databases/$(database)/documents/conversations/$(cid)).data)
        && get(/databases/$(database)/documents/conversations/$(cid)).data.participantIds is list
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participantIds;
    }

    function blockedBetween(data) {
      let other = otherParticipant(data);
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || !exists(/databases/$(database)/documents/users/$(other))
        || other in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blockedUserIds', [])
        || request.auth.uid in get(/databases/$(database)/documents/users/$(other)).data.get('blockedUserIds', []);
    }

    function canInteract(cid) {
      return participant(cid)
        && !blockedBetween(get(/databases/$(database)/documents/conversations/$(cid)).data);
    }

    function validCloudinaryUrl(value) {
      return value is string
        && value.matches('^https://res\\.cloudinary\\.com/mthzgqhv/(image|video|raw)/upload/.*');
    }

    function validOptionalCloudinaryPhoto(data) {
      return !data.keys().hasAny(['photoUrl']) || validCloudinaryUrl(data.photoUrl);
    }

    function profilePhotoHidden(data) {
      return data.get('privacy', {}).get('profilePhotoVisibility', 'Everyone') == 'Nobody';
    }

    function hiddenProfilePhotoIsNotPublished(uid, userData) {
      return !profilePhotoHidden(userData)
        || !existsAfter(/databases/$(database)/documents/directory/$(uid))
        || !getAfter(/databases/$(database)/documents/directory/$(uid)).data.keys().hasAny(['photoUrl']);
    }

    function validDirectoryPhotoForPrivacy(uid, data) {
      return !data.keys().hasAny(['photoUrl'])
        || (
          validCloudinaryUrl(data.photoUrl)
          && existsAfter(/databases/$(database)/documents/users/$(uid))
          && !profilePhotoHidden(getAfter(/databases/$(database)/documents/users/$(uid)).data)
        );
    }

    function validPresence() {
      return request.resource.data.isOnline is bool
        && request.resource.data.onlineVisible is bool
        && request.resource.data.lastSeenVisible is bool
        && request.resource.data.heartbeatAt is int
        && request.resource.data.lastSeen is int
        && request.resource.data.heartbeatAt <= request.time.toMillis() + 60000
        && request.resource.data.lastSeen <= request.time.toMillis() + 60000
        && (
          request.resource.data.onlineVisible
          || (request.resource.data.isOnline == false && request.resource.data.heartbeatAt == 0)
        )
        && (
          request.resource.data.lastSeenVisible
          || request.resource.data.lastSeen == 0
        );
    }

    match /users/{uid} {
      allow read: if owner(uid);

      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'bio', 'email', 'phoneNumber', 'photoUrl',
          'createdAt', 'appearance', 'privacy', 'notifications', 'blockedUserIds', 'tokens',
          'installationId', 'dataEpoch'
        ])
        && (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid == uid)
        && validOptionalCloudinaryPhoto(request.resource.data)
        && hiddenProfilePhotoIsNotPublished(uid, request.resource.data);

      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'bio', 'email', 'phoneNumber', 'photoUrl',
          'appearance', 'privacy', 'notifications', 'blockedUserIds', 'tokens',
          'installationId', 'dataEpoch'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoUrl'])
          || validOptionalCloudinaryPhoto(request.resource.data)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['privacy', 'photoUrl'])
          || hiddenProfilePhotoIsNotPublished(uid, request.resource.data)
        );

      allow delete: if owner(uid);

      match /devices/{deviceId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform == 'android'
          && request.resource.data.updatedAt == request.time;
      }

      match /mediaUploads/{assetId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['assetId', 'publicId', 'version', 'resourceType', 'secureUrl', 'signature', 'createdAt'])
          && request.resource.data.assetId == assetId
          && request.resource.data.publicId is string
          && request.resource.data.version is int
          && request.resource.data.resourceType in ['image', 'video', 'raw']
          && validCloudinaryUrl(request.resource.data.secureUrl)
          && request.resource.data.signature is string
          && request.resource.data.signature.matches('^[0-9a-f]{40}([0-9a-f]{24})?$')
          && request.resource.data.createdAt == request.time;
        allow update: if owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if false;
      }
    }

    match /directory/{uid} {
      allow read: if activeAccount();

      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'bio', 'photoUrl', 'createdAt'
        ])
        && (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid == uid)
        && validDirectoryPhotoForPrivacy(uid, request.resource.data);

      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'bio', 'photoUrl',
          'isOnline', 'onlineVisible', 'lastSeenVisible', 'heartbeatAt', 'lastSeen'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoUrl'])
          || validDirectoryPhotoForPrivacy(uid, request.resource.data)
        )
        // Presence moved out of the public directory. Legacy fields may only be deleted.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isOnline', 'onlineVisible', 'lastSeenVisible', 'heartbeatAt', 'lastSeen'
          ])
          || !request.resource.data.keys().hasAny([
            'isOnline', 'onlineVisible', 'lastSeenVisible', 'heartbeatAt', 'lastSeen'
          ])
        );

      allow delete: if owner(uid);
    }

    match /usernames/{username} {
      allow read: if activeAccount();

      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      allow update: if activeAccount()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      allow delete: if activeAccount() && resource.data.uid == request.auth.uid;
    }

    match /conversations/{cid} {
      allow read: if activeAccount()
        && request.auth.uid in resource.data.participantIds;

      allow create: if activeAccount()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && membersActive(request.resource.data)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(otherParticipant(request.resource.data)))
        && exists(/databases/$(database)/documents/directory/$(otherParticipant(request.resource.data)))
        && !blockedBetween(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'participantIds', 'lastMessageId', 'lastMessageTime', 'lastMessageText',
          'lastMessageSenderId', 'lastMessageRevision', 'lastMessageType', 'lastMessageExpiresAt', 'unreadCounts', 'deletedFor', 'deletedBefore',
          'hiddenLastFor', 'archivedFor', 'mutedFor', 'favoriteFor',
          'disappearingSeconds'
        ]);

      allow update: if participant(cid)
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageId', 'lastMessageTime', 'lastMessageText',
          'lastMessageSenderId', 'lastMessageE2ee', 'lastMessageRevision', 'lastMessageType', 'lastMessageExpiresAt', 'unreadCounts', 'deletedFor', 'deletedBefore',
          'hiddenLastFor', 'archivedFor', 'mutedFor', 'favoriteFor',
          'disappearingSeconds'
        ])
        // E2EE is retired. A legacy summary envelope may only be removed, never
        // added or replaced by current clients.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageE2ee'])
          || !request.resource.data.keys().hasAny(['lastMessageE2ee'])
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageText'])
          || (
            request.resource.data.lastMessageText is string
            && request.resource.data.lastMessageText.size() <= 500
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'lastMessageId', 'lastMessageSenderId', 'lastMessageType'
          ])
          || request.resource.data.lastMessageId == ''
          || (
            getAfter(/databases/$(database)/documents/conversations/$(cid)/messages/$(request.resource.data.lastMessageId)).data.senderId
              == request.resource.data.lastMessageSenderId
            && getAfter(/databases/$(database)/documents/conversations/$(cid)/messages/$(request.resource.data.lastMessageId)).data.type
              == request.resource.data.lastMessageType
          )
        );

      allow delete: if false;

      match /messages/{mid} {
        allow read: if participant(cid);

        allow create: if canInteract(cid)
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'text', 'type', 'mediaUrl',
            'voiceDurationSeconds', 'waveform', 'createdAt', 'status',
            'isDeleted', 'deletedForEveryone', 'hiddenFor', 'isEdited',
            'isPinned', 'reactions', 'replyToId', 'replyToText',
            'replyToSender', 'expiresAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 8000
          && request.resource.data.type in ['TEXT', 'IMAGE', 'VIDEO', 'AUDIO', 'VOICE', 'FILE', 'LOCATION']
          && (
            request.resource.data.type != 'TEXT'
            || request.resource.data.text.size() > 0
          )
          && (
            !(request.resource.data.type in ['IMAGE', 'VIDEO', 'AUDIO', 'VOICE', 'FILE'])
            || validCloudinaryUrl(request.resource.data.mediaUrl)
          )
          && request.resource.data.status == 'SENT'
          && request.resource.data.createdAt is int
          && request.resource.data.createdAt <= request.time.toMillis() + 60000
          && request.resource.data.createdAt >= request.time.toMillis() - 300000
          && request.resource.data.deletedForEveryone == false
          && request.resource.data.isDeleted == false
          && request.resource.data.isEdited == false
          && request.resource.data.isPinned == false
          && request.resource.data.hiddenFor is list
          && request.resource.data.hiddenFor.size() == 0
          && request.resource.data.reactions is list
          && request.resource.data.reactions.size() == 0
          && (!request.resource.data.keys().hasAny(['replyToId']) || request.resource.data.replyToId is string)
          && (!request.resource.data.keys().hasAny(['replyToText'])
              || (request.resource.data.replyToText is string && request.resource.data.replyToText.size() <= 500))
          && (!request.resource.data.keys().hasAny(['replyToSender'])
              || (request.resource.data.replyToSender is string && request.resource.data.replyToSender.size() <= 60))
          && (
            !request.resource.data.keys().hasAny(['expiresAt'])
            || (
              request.resource.data.expiresAt is int
              && request.resource.data.expiresAt > request.resource.data.createdAt
              && request.resource.data.expiresAt > request.time.toMillis()
              && request.resource.data.expiresAt <= request.resource.data.createdAt + 7776000000
            )
          );

        allow update: if participant(cid) && (
          (
            resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text', 'e2ee', 'isEdited', 'replyToId', 'replyToText', 'replyToSender'
            ])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 8000
            && !request.resource.data.keys().hasAny(['e2ee'])
            && request.resource.data.isEdited == true
          )
          ||
          (
            resource.data.senderId != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['DELIVERED', 'READ']
            && (request.resource.data.status == 'READ' || resource.data.get('status', 'SENT') != 'READ')
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned'])
            && request.resource.data.isPinned is bool
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
            && request.resource.data.hiddenFor is list
            && resource.data.hiddenFor is list
            && !(request.auth.uid in resource.data.hiddenFor)
            && request.auth.uid in request.resource.data.hiddenFor
            && request.resource.data.hiddenFor.hasAll(resource.data.hiddenFor)
            && request.resource.data.hiddenFor.size() == resource.data.hiddenFor.size() + 1
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions is list
            && request.resource.data.reactions.size() <= 20
          )
        );

        allow delete: if participant(cid)
          && (
            resource.data.senderId == request.auth.uid
            || (
              resource.data.keys().hasAny(['expiresAt'])
              && resource.data.expiresAt is int
              && resource.data.expiresAt <= request.time.toMillis()
            )
          );
      }

      match /typing/{uid} {
        allow read: if canInteract(cid);

        allow create, update: if owner(uid)
          && canInteract(cid)
          && request.resource.data.keys().hasOnly(['until'])
          && request.resource.data.until is int
          && request.resource.data.until >= 0
          && request.resource.data.until <= request.time.toMillis() + 15000;

        allow delete: if owner(uid) && canInteract(cid);
      }

      match /presence/{uid} {
        allow read: if canInteract(cid);

        allow create, update: if owner(uid)
          && canInteract(cid)
          && request.resource.data.keys().hasOnly([
            'isOnline', 'onlineVisible', 'lastSeenVisible', 'heartbeatAt', 'lastSeen'
          ])
          && validPresence();

        allow delete: if owner(uid) && participant(cid);
      }
    }

    // Only a recent owner session can request deletion. The client cannot mark a
    // job complete or supply a target list; the trusted worker discovers its scope.
    match /accountDeletionRequests/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.auth_time >= request.time.toMillis() / 1000 - 300
        && request.resource.data.keys().hasOnly(['uid', 'status', 'requestedAt', 'proofId'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.proofId is string
        && request.resource.data.proofId.matches('^[0-9a-f]{64}$')
        && !exists(/databases/$(database)/documents/deletionProofs/$(request.resource.data.proofId))
        && request.resource.data.requestedAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.auth.token.auth_time >= request.time.toMillis() / 1000 - 300
        && resource.data.status == 'failed'
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      // Only the worker removes this gate, after every old ID token expires.
      allow delete: if false;
    }

    match /deletionProofs/{proofId} {
      // A 256-bit random capability survives deleted/expired Auth. The worker
      // stores status/timestamps only, never a UID, profile or deletion targets.
      allow get: if proofId.matches('^[0-9a-f]{64}$');
      allow list, create, update: if false;
      allow delete: if proofId.matches('^[0-9a-f]{64}$') && resource.data.status == 'complete';
    }

    match /runtime/cleanup {
      allow get: if signedIn();
      allow list, write: if false;
    }

    match /reports/{reportId} {
      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly([
          'reporterId', 'reportedUid', 'reason', 'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && exists(/databases/$(database)/documents/directory/$(request.resource.data.reportedUid))
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 4
        && request.resource.data.reason.size() <= 500
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt <= request.time.toMillis() + 60000
        && request.resource.data.createdAt >= request.time.toMillis() - 300000;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
