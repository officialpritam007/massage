rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function conversationExists(cid) {
      return exists(/databases/$(database)/documents/conversations/$(cid));
    }

    function participant(cid) {
      return signedIn()
        && conversationExists(cid)
        && get(/databases/$(database)/documents/conversations/$(cid)).data.participantIds is list
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participantIds;
    }

    function validPrivateSettingsCreate() {
      return request.resource.data.keys().hasOnly([
        'appearance', 'privacy', 'notifications', 'blockedUserIds', 'tokens'
      ]);
    }

    function validPrivateSettingsUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'appearance', 'privacy', 'notifications', 'blockedUserIds', 'tokens'
      ]);
    }

    function validPresence() {
      return request.resource.data.isOnline is bool
        && request.resource.data.onlineVisible is bool
        && request.resource.data.lastSeenVisible is bool
        && request.resource.data.heartbeatAt is int
        && request.resource.data.lastSeen is int
        && request.resource.data.heartbeatAt <= request.time.toMillis() + 60000
        && request.resource.data.lastSeen <= request.time.toMillis() + 60000;
    }

    match /users/{uid} {
      // A private user document is readable only by its owner. Public contact data lives in /directory.
      allow read: if owner(uid);

      // Fresh/legacy accounts may race the authenticated profile bootstrap. Permit the owner to
      // create only client-owned private settings; identity fields remain server-authoritative.
      allow create: if owner(uid) && validPrivateSettingsCreate();
      allow update: if owner(uid) && validPrivateSettingsUpdate();
      allow delete: if false;
    }

    match /directory/{uid} {
      // Directory contains public identity plus privacy-filtered presence only.
      allow read: if signedIn();

      // Presence can race server-side profile repair. On create the Android client may create only
      // the five presence fields. Identity/profile fields are written by the authenticated API.
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly([
          'isOnline', 'onlineVisible', 'lastSeenVisible', 'heartbeatAt', 'lastSeen'
        ])
        && validPresence();

      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isOnline', 'onlineVisible', 'lastSeenVisible', 'heartbeatAt', 'lastSeen'
        ])
        && validPresence();

      allow delete: if false;
    }

    match /conversations/{cid} {
      allow read: if signedIn()
        && resource.data.participantIds is list
        && request.auth.uid in resource.data.participantIds;

      // Core chat remains available even when the optional Appwrite bridge is unavailable.
      // Creation is limited to a 1-to-1 conversation containing the authenticated user.
      allow create: if signedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.keys().hasOnly([
          'participantIds', 'lastMessageId', 'lastMessageTime', 'lastMessageText',
          'lastMessageSenderId', 'unreadCounts', 'deletedFor', 'deletedBefore',
          'hiddenLastFor', 'archivedFor', 'mutedFor', 'favoriteFor',
          'disappearingSeconds'
        ]);

      // Participant clients may update only conversation presentation/summary fields.
      allow update: if participant(cid)
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageId', 'lastMessageTime', 'lastMessageText',
          'lastMessageSenderId', 'unreadCounts', 'deletedFor', 'deletedBefore',
          'hiddenLastFor', 'archivedFor', 'mutedFor', 'favoriteFor',
          'disappearingSeconds'
        ]);

      allow delete: if false;

      match /messages/{mid} {
        allow read: if participant(cid);

        allow create: if participant(cid)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 8000
          && request.resource.data.type in ['TEXT', 'IMAGE', 'VIDEO', 'AUDIO', 'VOICE', 'FILE', 'LOCATION']
          && request.resource.data.status == 'SENT'
          && request.resource.data.createdAt is int
          && request.resource.data.createdAt <= request.time.toMillis() + 60000
          && request.resource.data.createdAt >= request.time.toMillis() - 300000
          && request.resource.data.deletedForEveryone == false
          && request.resource.data.isDeleted == false
          && request.resource.data.isEdited == false
          && request.resource.data.isPinned == false
          && request.resource.data.hiddenFor is list
          && request.resource.data.hiddenFor.size() == 0
          && request.resource.data.reactions is list
          && request.resource.data.reactions.size() == 0;

        allow update: if participant(cid) && (
          (
            resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 8000
            && request.resource.data.isEdited == true
          )
          ||
          (
            resource.data.senderId != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['DELIVERED', 'READ']
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned'])
            && request.resource.data.isPinned is bool
          )
        );

        // Only the original sender may permanently delete a message.
        allow delete: if participant(cid) && resource.data.senderId == request.auth.uid;
      }

      match /typing/{uid} {
        allow read: if participant(cid);
        allow create, update: if owner(uid)
          && participant(cid)
          && request.resource.data.keys().hasOnly(['until'])
          && request.resource.data.until is int
          && request.resource.data.until >= 0
          && request.resource.data.until <= request.time.toMillis() + 15000;
        allow delete: if owner(uid) && participant(cid);
      }
    }

    // Admin-SDK / authenticated-server-only collections: media metadata, rate limits, sessions,
    // tombstones, usernames and reports. Android clients must never read or mutate these directly.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
