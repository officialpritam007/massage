rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(id) { return signedIn() && request.auth.uid == id; }
    function participant(cid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participantIds;
    }
    match /users/{uid} {
      allow read: if owner(uid);
      // Identity, usernames and account deletion are handled only by the authenticated API.
      allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['appearance', 'privacy', 'notifications', 'blockedUserIds', 'tokens']);
      allow create, delete: if false;
    }
    match /directory/{uid} {
      allow read: if signedIn();
      allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isOnline', 'onlineVisible', 'lastSeenVisible', 'heartbeatAt', 'lastSeen'])
        && request.resource.data.isOnline is bool
        && request.resource.data.onlineVisible is bool
        && request.resource.data.lastSeenVisible is bool
        && request.resource.data.heartbeatAt is int
        && request.resource.data.lastSeen is int;
      allow create, delete: if false;
    }
    match /conversations/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow write: if false;
      match /messages/{mid} {
        allow read: if participant(cid);
        allow write: if false;
      }
      match /typing/{uid} {
        allow read: if participant(cid);
        allow create, update: if owner(uid) && participant(cid)
          && request.resource.data.keys().hasOnly(['until'])
          && request.resource.data.until is int
          && request.resource.data.until <= request.time.toMillis() + 15000;
        allow delete: if owner(uid) && participant(cid);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
