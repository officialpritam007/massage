{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid','isOnline','onlineVisible','lastSeenVisible','heartbeatAt','lastSeen']) && newData.child('uid').val() === $uid && newData.child('isOnline').isBoolean() && newData.child('onlineVisible').isBoolean() && newData.child('lastSeenVisible').isBoolean() && newData.child('heartbeatAt').isNumber() && newData.child('lastSeen').isNumber()",
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
