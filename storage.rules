rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Liquid Chat media is stored in Appwrite and is exposed only through short-lived,
    // server-authorized URLs. Firebase Storage remains locked down to prevent legacy paths
    // from bypassing Appwrite ownership, participant validation or deletion revocation.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
